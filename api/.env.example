# This application uses PostgreSQL via node-postgres/Drizzle.
# Use a development-only PostgreSQL database; do not point tests at production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mu_katale"
# Set true only when the API cannot be reached except through your own trusted nginx proxy.
TRUST_PROXY="false"
# Admin credentials, used only by npm run db:seed:admin.
# Never commit a real password; api/.env.local is gitignored.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Required: the shared secret the payment gateway signs callbacks with.
PAYMENT_WEBHOOK_SECRET=
# Browser origins allowed to call this API from another site, comma separated:
# WEB_ORIGINS=https://you.github.io
# Leave unset for same-origin deployments (the dev proxy, the docker stack). When
# set, the API answers CORS for those origins, accepts their mutating requests,
# and writes session cookies as SameSite=None; Secure. The frontend must also be
# built with VITE_API_BASE pointing at this host. See src/lib/webOrigins.ts.
WEB_ORIGINS=
# Required: absolute or relative directory where uploaded product images are
# written. Docker uses /app/uploads with a volume mounted over it.
UPLOAD_DIR="./uploads"
