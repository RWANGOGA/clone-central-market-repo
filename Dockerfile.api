FROM node:22-alpine AS builder

WORKDIR /app

COPY api/package*.json ./api/
COPY api/tsconfig.json ./api/
COPY api/next.config.mjs ./api/
COPY api/drizzle.config.ts ./api/
COPY api/src ./api/src
COPY api/data ./api/data

WORKDIR /app/api

RUN npm config set fetch-timeout 300000 && \
    npm config set fetch-retries 5 && \
    npm config set registry https://registry.npmjs.org/ && \
    npm ci --prefer-offline --no-audit --maxsockets 3 || \
    (sleep 5 && npm ci --prefer-offline --no-audit --maxsockets 3) || \
    (sleep 10 && npm ci --prefer-offline --no-audit --maxsockets 3)

# next build imports every route to collect page data, and lib/env.ts validates
# the environment as those modules load, so a build with no environment fails on
# missing keys rather than on anything about the code. These satisfy the schema
# only: no database is contacted while building, and they live in the builder
# stage, so they never reach the image that runs. The real values arrive from the
# compose environment at runtime.
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV PAYMENT_WEBHOOK_SECRET=build-time-placeholder
ENV UPLOAD_DIR=/app/data/uploads

RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

RUN apk add --no-cache postgresql-client

COPY --from=builder /app/api/.next/standalone ./
COPY --from=builder /app/api/.next/static ./.next/static

ENV NODE_ENV=production
ENV PORT=3000
ENV UPLOAD_DIR=/app/data/uploads

RUN mkdir -p /app/data/uploads /app/api/drizzle && \
    chown -R node:node /app/data /app/api/drizzle

COPY api/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

USER node

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "server.js"]
